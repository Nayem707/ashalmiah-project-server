# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoply?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173

# Uploads
# Physical disk directory (relative to server cwd in development).
# Production/Coolify: set to absolute volume mount path `/uploads`.
UPLOAD_DIR=uploads
# Public URL path served by Express and stored in the DB (keep `/uploads`).
UPLOAD_PUBLIC_PATH=/uploads
MAX_UPLOAD_SIZE_MB=5

# Rate limiting (applied in production only; disabled in development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Firebase Admin SDK (required for Google sign-in token verification)
# From Firebase Console → Project settings → Service accounts → Generate new private key
FIREBASE_PROJECT_ID=
# Recommended: place the JSON next to server/ and point to it
FIREBASE_SERVICE_ACCOUNT_PATH=firebase-service-account.json
# Or set these instead of the file path:
# FIREBASE_CLIENT_EMAIL=
# FIREBASE_PRIVATE_KEY=
