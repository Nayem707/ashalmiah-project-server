# Server
NODE_ENV=development
PORT=5000
API_PREFIX=/api/v1

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/shoply?schema=public"

# JWT
JWT_ACCESS_SECRET=change_me_access_secret
JWT_REFRESH_SECRET=change_me_refresh_secret
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# CORS (comma-separated origins)
CORS_ORIGINS=http://localhost:5173,https://alifadressshop.io,https://www.alifadressshop.io

# Uploads
# Physical disk directory (relative to server cwd in development).
# Production/Coolify: set to absolute volume mount path `/uploads`.
UPLOAD_DIR=uploads
# Public URL path served by Express and stored in the DB (keep `/uploads`).
UPLOAD_PUBLIC_PATH=/uploads
MAX_UPLOAD_SIZE_MB=5

# Rate limiting (applied in production only; disabled in development)
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300

# Firebase Admin SDK (required for Google sign-in token verification)
# Preferred: path to service-account JSON (relative to process.cwd() or absolute).
# FIREBASE_PRIVATE_KEY is optional when the JSON file is present.
FIREBASE_PROJECT_ID=
FIREBASE_CLIENT_EMAIL=
FIREBASE_SERVICE_ACCOUNT_PATH=yarpacom-a0219-firebase-adminsdk-fl8sg-f71b1bcf11.json
# Optional fallback instead of the JSON file:
# FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----\n"