{
  "info": {
    "name": "Shoply Backend API",
    "description": "Production-ready Postman collection for the Shoply e-commerce backend (Express + TypeScript + Prisma + PostgreSQL).\n\nBase URL is configured via the `baseUrl` collection variable and defaults to `http://localhost:5000/api/v1`.\n\nAuth: the Login and Register requests automatically store `accessToken` and `refreshToken` into collection variables. All protected requests inherit `Bearer {{accessToken}}` from the collection.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [{ "key": "token", "value": "{{accessToken}}", "type": "string" }]
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:5000/api/v1", "type": "string" },
    { "key": "accessToken", "value": "", "type": "string" },
    { "key": "refreshToken", "value": "", "type": "string" },
    { "key": "productId", "value": "", "type": "string" },
    { "key": "productSlug", "value": "", "type": "string" },
    { "key": "categoryId", "value": "", "type": "string" },
    { "key": "colorId", "value": "", "type": "string" },
    { "key": "sizeId", "value": "", "type": "string" },
    { "key": "orderId", "value": "", "type": "string" },
    { "key": "userId", "value": "", "type": "string" },
    { "key": "addressId", "value": "", "type": "string" },
    { "key": "reviewId", "value": "", "type": "string" },
    { "key": "cartItemId", "value": "", "type": "string" },
    { "key": "sectionKey", "value": "hero", "type": "string" },
    { "key": "slideId", "value": "", "type": "string" },
    { "key": "uploadKey", "value": "", "type": "string" }
  ],
